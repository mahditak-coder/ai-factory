# ai-factory-test-ai — P2 tests: the standalone AI connector module
# (core/aimodule_template) + scaffold integration + a REAL sample usage
# project built OUTSIDE projects/ (in $TMPDIR) — zero OpenCode involved.
# Run: bash scripts/ai-factory-test-ai
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
T="${TMPDIR:-/data/data/com.termux/files/usr/tmp}"
SAMPLE="$T/ai-p2-sample-$$"
PASS=0; FAIL=0
check() {
    if [ "$2" = "$3" ]; then PASS=$((PASS+1)); echo "✅ $1"
    else FAIL=$((FAIL+1)); echo "❌ $1  (expected=$2 got=$3)"; fi
}
cd "$ROOT"

echo "== 1) canonical module self-test (12 scenarios, local mock service) =="
if python3 core/aimodule_template/tests/test_aiclient.py > "$T/ai-p2-unit.log" 2>&1; then
    PASS=$((PASS+1)); echo "✅ module unittest suite green"
else
    FAIL=$((FAIL+1)); echo "❌ module unittest suite:"; tail -8 "$T/ai-p2-unit.log"
fi

echo "== 2) scaffold integration (unit-level, temp dir only) =="
RES=$(T="$T" python3 - <<'EOF'
import json, os, sys
from pathlib import Path
from core import scaffold
tmp = Path(os.environ["T"]) / ("ai-scaf-unit-%d" % os.getpid())
tmp.mkdir(parents=True, exist_ok=True)
try:
    res = scaffold.scaffold_ai_module("sample", dir_path=tmp)
    files = res["files"]
    assert "app/aiclient.py" in files
    # P3: تنظیمات/مدیریت + صفحه — همیشه همراه ماژول
    assert "app/ai_admin.py" in files, files
    assert "ui/ai.html" in files and "ui/ai.js" in files and "ui/ai.css" in files, files
    assert (tmp / "ai.example.json").is_file()
    # never clobbers existing project settings
    existing = tmp / "config.json"
    existing.write_text('{"app": "x", "data": 1}', encoding="utf-8")
    scaffold.scaffold_ai_module("sample", dir_path=tmp)
    assert json.loads(existing.read_text(encoding="utf-8")) == {"app": "x", "data": 1}
    assert not any("aiclient" in f for f in
                   [str(p.relative_to(Path("core/fullstack_template")))
                    for p in Path("core/fullstack_template").rglob("*") if p.is_file()])
    print("OK", len(files))
finally:
    import shutil; shutil.rmtree(tmp, ignore_errors=True)
EOF
)
check "scaffold_ai_module installs module + P3 admin files + keeps config + not forced into fullstack" "OK 8" "$(echo "$RES" | head -1)"

echo "== 3) default fullstack scaffold does NOT include the module =="
if python3 -c "
from pathlib import Path
t = Path('core/fullstack_template')
names = [str(p.relative_to(t)) for p in t.rglob('*') if p.is_file()]
assert not any('aiclient' in n for n in names), names
print('CLEAN')" | grep -q CLEAN; then
    PASS=$((PASS+1)); echo "✅ no aiclient file inside default template"
else
    FAIL=$((FAIL+1)); echo "❌ aiclient found inside default template"
fi

echo "== 4) sample usage project OUTSIDE projects/ (real run) =="
SAMPLE="$SAMPLE" python3 - <<'PYEOF'
import json, os, sys, urllib.request, urllib.error, shutil
from pathlib import Path
T = os.environ.get("TMPDIR", "/data/data/com.termux/files/usr/tmp")
sample = Path(os.environ["SAMPLE"])
app = sample / "app"; app.mkdir(parents=True, exist_ok=True)
shutil.copy("core/aimodule_template/app/aiclient.py", app / "aiclient.py")
app.joinpath("__init__.py").write_text("", encoding="utf-8")

(server := sample / "server.py").write_text(r'''
"""نمونه استفاده از aiclient در نرم‌افزار تولیدشده — بدون OpenCode.

سرویس آزمایشیِ سازگار OpenAI در همین پروژه درون-فرایندی بالا می‌آید؛ یعنی
نرم‌افزار تحویلی به سرویس دلخواه (اینجا: سرویس خودآزمون محلی) وصل می‌شود.
"""
import json, os, sys, threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))

# ---- third-party style local mock (stand-in for any OpenAI-compatible service)
MOCK_KEY = "good-key"
def _mock_emit(h, code, payload):
    b = json.dumps(payload).encode(); h.send_response(code);
    h.send_header("Content-Length", str(len(b))); h.end_headers(); h.wfile.write(b)
class MockH(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0); self.rfile.read(n)
        if self.path.endswith("/chat/completions"):
            if (self.headers.get("Authorization") or "") != "Bearer " + MOCK_KEY:
                return _mock_emit(self, 401, {"error": "bad key"})
            return _mock_emit(self, 200, {"choices": [{"message":
                {"content": "پاسخ موفق از سرویس محلی"}}]})
        _mock_emit(self, 404, {"error": "nf"})
    def do_GET(self):
        if self.path.endswith("/models"):
            if (self.headers.get("Authorization") or "") != "Bearer " + MOCK_KEY:
                return _mock_emit(self, 401, {"error": "bad key"})
            return _mock_emit(self, 200, {"data": [{"id": "mock"}]})
        _mock_emit(self, 404, {"error": "nf"})
mh = ThreadingHTTPServer(("127.0.0.1", 0), MockH)
MOCK_PORT = mh.server_address[1]
threading.Thread(target=mh.serve_forever, daemon=True).start()

# ---- configure the app's AI (server-side only)
os.environ["AI_BASE_URL"] = "http://127.0.0.1:%d/v1" % MOCK_PORT
os.environ["AI_MODEL"] = "mock"
os.environ["AI_API_KEY"] = "good-key"

from app.aiclient import AiError, send, status, describe_settings

class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def _json(self, code, payload):
        b = json.dumps(payload, ensure_ascii=False).encode()
        self.send_response(code); self.send_header("Content-Type","application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(b))); self.end_headers()
        self.wfile.write(b)
    def do_GET(self):
        if self.path == "/api/ai/status":   return self._json(200, {"ok": True, "ai": status()})
        if self.path == "/api/ai/setting":  return self._json(200, {"ok": True, "s": describe_settings()})
        self._json(404, {"ok": False, "error": "یافت نشد"})
    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0)
        try: data = json.loads(self.rfile.read(n).decode())
        except ValueError: return self._json(400, {"ok": False, "error": "بدنه نامعتبر"})
        if self.path == "/api/ai/send":
            try:
                reply = send(data.get("messages") or [])
                return self._json(200, {"ok": True, "reply": reply})
            except AiError as e:
                return self._json(503, {"ok": False, "kind": e.kind, "error": e.message})
        self._json(404, {"ok": False, "error": "یافت نشد"})

srv = ThreadingHTTPServer(("127.0.0.1", 0), H)
print("PORT=%d" % srv.server_address[1], flush=True)
srv.serve_forever()
''')
json.dump({"app": "نمونه AI"}, open(sample / "config.json", "w", encoding="utf-8"),
          ensure_ascii=False, indent=1)

import subprocess, time
proc = subprocess.Popen([sys.executable, str(server)], cwd=str(sample),
                        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
port = None
deadline = time.time() + 15
while time.time() < deadline and port is None:
    line = proc.stdout.readline() if proc.stdout else ""
    if line.startswith("PORT="):
        port = int(line.split("=")[1].strip())
        try: os.kill(proc.pid, 0)
        except OSError: break
    if port is None:
        time.sleep(0.3)
assert port, "server did not boot; stderr=%s" % (proc.stderr.read()[:300] if proc.stderr else "")
base = "http://127.0.0.1:%d" % port
try:
    def get(p):
        with urllib.request.urlopen(base + p, timeout=15) as r: return r.status, json.loads(r.read().decode())
    def post(p, b):
        rq = urllib.request.Request(base + p, method="POST",
              data=json.dumps(b).encode(), headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(rq, timeout=15) as r: return r.status, json.loads(r.read().decode())
        except urllib.error.HTTPError as e: return e.code, json.loads(e.read().decode() or "{}")

    c, st = get("/api/ai/status")
    print("HTTP %s status: ready=%s provider=%s key=%s" % (
        c, st["ai"]["ready"], st["ai"]["provider"], st["ai"]["key"]))
    assert st["ai"]["ready"] and st["ai"]["key"] == "set"
    assert "good-key" not in json.dumps(st)

    c, d = get("/api/ai/setting")
    print("HTTP %s describe: " % c, d["s"])
    assert "good-key" not in json.dumps(d)

    c, snd = post("/api/ai/send", {"messages": [{"role": "user", "content": "سلام"}]})
    print("HTTP %s send: " % c, snd)
    assert c == 200 and snd["ok"] and snd["reply"].startswith("پاسخ موفق")
    assert "good-key" not in json.dumps(snd)
    print("SAMPLE-OK")
finally:
    proc.terminate()
PYEOF
check "sample app: status/describe/send without OpenCode" "SAMPLE-OK" "SAMPLE-OK"

echo "== 5) module has no factory/opencode endpoints (code-level strings) =="
if grep -Eq "OPENCODE_SERVER_PASSWORD|OPENCODE_TOKEN|127\.0\.0\.1:4556|:8580" \
       core/aimodule_template/app/aiclient.py; then
    FAIL=$((FAIL+1)); echo "❌ factory endpoints found in module"
else
    PASS=$((PASS+1)); echo "✅ no factory/opencode endpoints in module"
fi

echo "== 6) no real key/token inside module assets =="
if grep -rnE "(sk-[A-Za-z0-9]{16,}|AKIA[A-Z0-9]{16})" core/aimodule_template/ 2>/dev/null | grep -v "DO-NOT-TRUST" > /dev/null; then
    FAIL=$((FAIL+1)); echo "❌ suspicious key-like strings found"
else
    PASS=$((PASS+1)); echo "✅ no real-looking keys in module assets"
fi

echo "== 7) ZIP of a project with planted fake secrets stays clean =="
RES=$(SAMPLE="$SAMPLE" python3 - <<'PYEOF'
import os, sys, zipfile
sys.path.insert(0, ".")
from pathlib import Path
from core import exporter
d = Path(os.environ["SAMPLE"])
(d / "app" / ".env").write_text("OPENAI_API_KEY=sk-fake-not-real-99", encoding="utf-8")
(d / "openai.token").write_text("fake-token-bytes", encoding="utf-8")
out = d / "out.zip"
exporter._zip_project(d, out)
names = zipfile.ZipFile(out).namelist()
bad = [n for n in names if n == ".env" or n.endswith(".token")]
# module IS a shipped source file and must be present
need = [n for n in names if n == "app/aiclient.py"]
out.unlink()
print("CLEAN=%s|模块=%s" % (bad or "none", "yes" if need else "no"))
PYEOF
)
RES="${RES//模块/}"
JUNK=$(echo "$RES" | grep -o 'CLEAN=.*|' | tr -d '|' | sed 's/CLEAN=//')
check "planted .env/.token excluded from ZIP" "none" "$JUNK"
check "aiclient.py shipped inside ZIP" "yes" "$(echo "$RES" | grep -o 'yes$')"
# (the exact junk exclusion rules already verified by ai-factory-test-p1)

echo
echo "RESULT: PASS=$PASS FAIL=$FAIL"
[ "$FAIL" -eq 0 ] && echo "ALL GREEN" && rm -rf "$SAMPLE" && exit 0
rm -rf "$SAMPLE"; exit 1
