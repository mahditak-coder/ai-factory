#!/usr/bin/env bash
# ai-factory-test-p10-1 — R4-a: single source of truth for project types.
#   Part A: parity config↔factory, frozen order, contracts preserved (no server)
#   Part B: endpoint auth/unauth + both dashboards fetch from API + real create
#   Part C: PWA contract intact on the real product + FULL regression battery
#           (p5, p6, p7-1..5, p8-0/1/3/4)
# NOTE: p8-2 (build driver) is deliberately NOT in this battery — running it
# would re-build/MODIFY the existing project p8-app-demo, which this mission
# forbids. Its acceptance evidence lives in docs/test-reports/p8/.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BASE="http://127.0.0.1:8580"
T="${TMPDIR:-/data/data/com.termux/files/usr/tmp}"; mkdir -p "$T/p10"
PASS=0; FAIL=0; FAILED=""

check() {
    if [ "$2" = "$3" ]; then PASS=$((PASS+1)); echo "  ✅ $1"
    else FAIL=$((FAIL+1)); FAILED="$FAILED|$1"; echo "  ❌ $1 (expected=$2 got=$3)"; fi
}

cd "$ROOT"
if ! curl -fsS "$BASE/api/health" >/dev/null 2>&1; then
    bash "$ROOT/scripts/ai-factory-start" >/dev/null; sleep 2
fi

echo "════ P10-1/A — منبع واحد: تطابق config ↔ factory (بدون سرور)"
A=$(PYTHONDONTWRITEBYTECODE=1 python3 - <<'PYEOF'
import json, sys
sys.path.insert(0, ".")
from core import factory
import core.config as C
FROZEN = ["webpage", "webapp", "pwa", "shop", "dashboard", "webtool",
          "api", "ai-tool", "fullstack", "fullstack-python"]
out = {}
out["order"] = list(C.PROJECT_TYPE_SPECS) == FROZEN and list(C.PROJECT_TYPES) == FROZEN
out["unique"] = len(set(C.PROJECT_TYPE_SPECS)) == 10
out["engine"] = dict(factory.TYPES) == {t: C.PROJECT_TYPE_SPECS[t]["engine_label"] for t in FROZEN}
out["contracts"] = dict(factory.TYPE_REQUIREMENTS) == {
    t: C.PROJECT_TYPE_SPECS[t]["contract"] for t in FROZEN
    if C.PROJECT_TYPE_SPECS[t].get("contract")}
out["fullstack"] = (factory.FULLSTACK_TYPES is C.FULLSTACK_TYPES
                    and C.FULLSTACK_TYPES == ("fullstack", "fullstack-python"))
out["fs"] = factory.FS_REQUIREMENT == C.FS_REQUIREMENT and "server.py" in C.FS_REQUIREMENT
sub = {"webpage": "{{placeholder}}", "webtool": "form", "shop": "data-product",
       "api": "/api/health", "dashboard": "داشبورد", "ai-tool": "/ai.html",
       "pwa": "manifest.json"}
out["contract_bodies"] = all(k in factory.TYPE_REQUIREMENTS
                             and sub[k] in factory.TYPE_REQUIREMENTS[k]
                             and factory.TYPE_REQUIREMENTS[k].strip().startswith(
                                 "الزامات قرارداد تست")
                             for k in sub)
out["pwa_sw"] = "serviceWorker" in factory.TYPE_REQUIREMENTS["pwa"]
print(json.dumps(out))
PYEOF
)
for k in order unique engine contracts fullstack fs contract_bodies pwa_sw; do
    V=$(echo "$A" | python3 -c "import json,sys;print(json.load(sys.stdin)['$k'])")
    check "P10-1-A:$k" "True" "$V"
done

HARD=$(grep -c "TYPES = dict((tid, label)\|TYPE_REQUIREMENTS = {" core/factory.py)
check "P10-1-A9 در factory.py تعریف دستی جامانده" "0" "$HARD"
SPEC=$(grep -c "PROJECT_TYPE_SPECS = {" core/config.py)
check "P10-1-A10 فقط یک تعریف SPECS در config.py" "1" "$SPEC"

echo "════ P10-1/B — endpoint و داشبوردها"
# AF-05.1: credential از فایل امن محلی — بدون پیش‌فرض ثابت
P10_PW="${PANEL_PASS:-}"
if [ -z "$P10_PW" ] && [ -r "$HOME/.af-panel/panel-pass.txt" ]; then
    P10_PW="$(tr -d '\n\r' < "$HOME/.af-panel/panel-pass.txt")"
fi
if [ -z "$P10_PW" ]; then
    echo "panel credential missing — set PANEL_PASS or create ~/.af-panel/panel-pass.txt (0600)" >&2
    exit 1
fi
rm -f "$T/p10.cookies"
UN=$(curl -s -m8 -o /dev/null -w '%{http_code}' "$BASE/api/factory/types")
check "P10-1-B1 endpoint بدون احراز هویت → 401" "401" "$UN"
curl -s -m8 -c "$T/p10.cookies" -X POST -d "{\"password\":\"$P10_PW\"}" \
    -H 'Content-Type: application/json' "$BASE/api/panel/login" >/dev/null
curl() { command curl -b "$T/p10.cookies" "$@"; }
EP=$(curl -s -m8 "$BASE/api/factory/types" | python3 -c "
import json,sys
d = json.load(sys.stdin)
FROZEN = ['webpage','webapp','pwa','shop','dashboard','webtool','api','ai-tool','fullstack','fullstack-python']
ts = d.get('types') or []
ok = (d.get('ok') is True and [t['id'] for t in ts] == FROZEN
      and all(isinstance(t['contract'], bool) and t['label'] for t in ts)
      and any(t['id'] == 'pwa' and 'PWA' in t['label'] for t in ts))
print('ok' if ok else 'bad')")
check "P10-1-B2 endpoint با احراز هویت: ۱۰ نوع + ترتیب منجمد + فیلدها" "ok" "$EP"
FJ=$(curl -s -m8 "$BASE/factory.js")
WJ=$(curl -s -m8 "$BASE/work.js")
echo "$FJ" | grep -q "api/factory/types" && A1=ok || A1=no
echo "$FJ" | grep -q "const TYPES = \[" && A2=leak || A2=ok
check "P10-1-B3 factory.js از API می‌خواند" "ok" "$A1"
check "P10-1-B4 factory.js بدون هاردکد TYPES" "ok" "$A2"
echo "$WJ" | grep -q "api/factory/types" && A3=ok || A3=no
echo "$WJ" | grep -q 'const type = "fullstack"' && A4=leak || A4=ok
check "P10-1-B5 work.js از API می‌خواند" "ok" "$A3"
check "P10-1-B6 work.js بدون هاردکد نوع" "ok" "$A4"

TS=$(date +%H%M%S); PROJ="p10x-ssot-$TS"
CS=$(grep -oE 'panel_csrf[[:space:]]+[A-Za-z0-9_-]+' "$T/p10.cookies" | head -1 | awk '{print $2}')
CR=$(curl -s -m20 -o /dev/null -w '%{http_code}' -X POST \
    -d "{\"name\":\"$PROJ\",\"type\":\"webpage\",\"description\":\"p10-1 ssot\"}" \
    -H 'Content-Type: application/json' -H "X-Panel-CSRF: $CS" \
    --cookie "$T/p10.cookies" "$BASE/api/factory/projects")
check "P10-1-B7 ساخت واقعی پروژهٔ webpage (API)" "201" "$CR"
MT=$(python3 -c "import json;print(json.load(open('projects/$PROJ/meta.json')).get('type',''))" 2>/dev/null)
check "P10-1-B8 meta.type == webpage" "webpage" "$MT"
curl -s -m30 -o /dev/null -X POST -d "{\"project\":\"$PROJ\",\"confirm\":true}" \
    -H 'Content-Type: application/json' -H "X-Panel-CSRF: $CS" \
    --cookie "$T/p10.cookies" "$BASE/api/factory/delete"
LEFT=$(ls projects/ 2>/dev/null | grep -c "p10x-ssot")
check "P10-1-B9 پاک‌سازی پروژهٔ آزمایشی" "0" "$LEFT"

echo "════ P10-1/C — قرارداد PWA روی محصول واقعی"
TR=$(curl -s -m60 -X POST -d '{"project":"p8-app-demo"}' \
    -H 'Content-Type: application/json' -H "X-Panel-CSRF: $CS" \
    --cookie "$T/p10.cookies" \
    "$BASE/api/factory/testrun" | python3 -c "
import json,sys
r = json.load(sys.stdin)
c = r.get('contract') or {}
print('ok' if r.get('ok') and c.get('ok') else 'red')")
check "P10-1-C1 قرارداد PWA پس از ریفکتور: سبز (p8-app-demo)" "ok" "$TR"

echo "════ P10-1/C — باتری رگرسیون کامل (واقعی، یکی‌یکی)"
REGP=0; REGF=0; REGLIST=""
for S in p5 p6 p7-1 p7-2 p7-3 p7-4 p7-5 p8-0 p8-1 p8-3 p8-4; do
    bash "$ROOT/scripts/ai-factory-test-$S" > "$T/p10/reg-$S.log" 2>&1
    RC=$?
    if [ "$RC" = "0" ]; then REGP=$((REGP+1)); echo "  ✅ reg-$S exit=0"
    else REGF=$((REGF+1)); REGLIST="$REGLIST $S"; echo "  ❌ reg-$S exit=$RC (ببین: $T/p10/reg-$S.log)"; fi
done
check "P10-1-C2 هر ۱۱ سوئیت رگرسیون exit=0" "0" "$REGF"
[ -n "$REGLIST" ] && echo "  ناموفق:$REGLIST"

echo "──────────────────"
echo "نتیجهٔ P10-1: $PASS موفق، $FAIL ناموفق (رگرسیون: $REGP سبز، $REGF قرمز)"
[ "$FAIL" -gt 0 ] && echo "ناموفق: $FAILED"
[ "$FAIL" -eq 0 ] && echo "ALL GREEN" && exit 0
exit 1
