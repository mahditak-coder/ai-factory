# AF-05 — سیاست محافظه‌کارانه مخزن محلی: فقط سورس و مستندات.
# همهٔ داده اجرایی، لاگ، راز، پروژه کاربر، خروجی و پشتیبان مطلقاً خارج از Git.

# ── داده اجرایی و حالت (هش ادمین، صف تسک، استقرارها، حافظه) ──
/data/

# ── لاگ‌ها، توکن‌ها، pidها ──
/logs/

# ── پشتیبان‌های موتور و نسخه‌ها ──
/backups/

# ── پروژه‌های کاربر و محصولات مستقل (هرگز) ──
/projects/

# ── خروجی‌های ساخته‌شده و گزارش‌ها (APK/AAB/ZIP/AF-*-REPORT.md) ──
/exports/

# ── محیط توسعهٔ موقت و رکورد زمان اجرا ──
/WORKDIR/
/.factory.meta_rec
/p10-ref.json

# ── رازها و اعتبارها در هر نقطه از درخت Track‌شده ──
*.env
*.token
*.pem
*.key
*.jks
*.keystore
*.p12
opencode.json

# ── خروجی‌های Build و کش ──
*.apk
*.aab
*.apks
*.idsig
*.zip
*.pyc
__pycache__/
node_modules/

# ── نویز ویرایشگر ──
*.swp
*~
.DS_Store

# ── اعتبار پنل (AF-05.1) ──
# رمز پنل دیگر در هیچ سورس/مستندی ثابت نیست؛ در فایل امن خارج از مخزن است:
#   ~/.af-panel/panel-pass.txt  (0600، زیر HOME — خارج از ریشهٔ این مخزن)
# برای دفاع لایه‌ای، هر نسخه‌ای از آن اگر داخل مخزن ظاهر شود ممنوع است:
panel-pass.txt
.af-panel/

# ── دفاع لایه‌ای: پایگاه‌دادهٔ کاربران و کلید متقارن (حتی بیرون از data/) ──
*.db
*.sqlite
*.sqlite3
secret.key
